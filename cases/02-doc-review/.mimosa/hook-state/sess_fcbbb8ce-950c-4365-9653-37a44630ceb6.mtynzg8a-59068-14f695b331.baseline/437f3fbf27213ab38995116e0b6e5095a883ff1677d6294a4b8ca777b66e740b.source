"""NO.2 车管所网办材料审核：两级规则引擎 + 置信度分流。

对应案例 NO.2 的技术路径「看、读、填、搬」中的"看与判断"：
- ReviewEngineV1  基础规则：必需材料齐全 + 必填字段非空（第一版能上线的最小能力）
- ReviewEngineV2  交叉校验版（优化）：
    R1 材料齐全性与必填字段
    R2 身份证/统一社会信用代码校验位
    R3 跨材料姓名一致性（身份证 vs 合同/发票当事人）
    R4 跨材料金额一致性（发票 vs 合同，容差 0.01 元）
    R5 有效期检查（早于 2023-06 的日期视为过期）
    R6 置信度分流：任一材料 conf < 0.9 → 转人工复核（对应"拍摄质量五花八门"）

判定输出 pass / review / reject；评审口径：
- 漏放率(false accept)：有缺陷却被自动 pass —— 政务场景红线，要求 ≈ 0
- 误拦率(false block)：无缺陷却被 reject/review —— 影响自动化率
- 自动通过率：无需人工的办件占比（对应日均 800→1100 件的产能释放）
"""
from __future__ import annotations

from dataclasses import dataclass, field

REQUIRED = {
    "抵押登记": ["身份证", "抵押合同", "营业执照", "发票"],
    "转移登记": ["身份证", "购车发票", "登记证书"],
    "变更登记": ["身份证", "营业执照", "变更证明"],
    "补领证书": ["身份证", "申请表"],
    "注销抵押": ["身份证", "抵押合同", "还款证明"],
    "申领号牌": ["身份证", "购车发票", "交强险保单"],
}
ID_WEIGHTS = [1, 9, 8, 7, 6, 5, 4, 3, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2]
CHECK_CODES = "10X98765432"
EXPIRY_CUTOFF = "2023-06-01"
CONF_HUMAN = 0.9  # 低于此置信度转人工


@dataclass
class Decision:
    action: str                      # pass / review / reject
    reasons: list[str] = field(default_factory=list)
    auto: bool = False               # 是否无需人工


def check_code_ok(num: str) -> bool:
    if len(num) != 18:
        return False
    body, code = num[:17], num[17].upper()
    return CHECK_CODES[sum(int(a) * b for a, b in zip(body, ID_WEIGHTS)) % 11] == code


class ReviewEngineV1:
    def review(self, case: dict) -> Decision:
        reasons = []
        need = REQUIRED[case["biz"]]
        missing = [d for d in need if d not in case["docs"]]
        if missing:
            reasons.append(f"缺材料:{','.join(missing)}")
        for name, doc in case["docs"].items():
            if not doc:
                reasons.append(f"{name}:空材料")
        if reasons:
            return Decision("reject", reasons)
        return Decision("pass", reasons, auto=True)


class ReviewEngineV2:
    def review(self, case: dict) -> Decision:
        d = ReviewEngineV1().review(case)
        reasons = list(d.reasons)
        if d.action == "reject":
            return Decision("reject", reasons)
        docs = case["docs"]
        # R2 校验位
        if "身份证" in docs and not check_code_ok(docs["身份证"]["id_number"]):
            reasons.append("身份证校验位错误")
        # R3 姓名一致性
        ids = docs.get("身份证", {}).get("name")
        for k in ("抵押合同", "购车发票"):
            if ids and k in docs and docs[k].get("party") not in (None, ids):
                reasons.append(f"{k}当事人与身份证不一致")
        # R4 金额一致性
        amounts = {k: v["amount"] for k, v in docs.items()
                   if isinstance(v.get("amount"), (int, float))}
        if amounts:
            lo = min(amounts.values())
            hi = max(amounts.values())
            if hi - lo > 0.011:
                reasons.append(f"跨材料金额不一致({lo:.2f}~{hi:.2f})")
        # R5 过期
        for k, v in docs.items():
            if v.get("date") and v["date"] < EXPIRY_CUTOFF:
                reasons.append(f"{k}已过期")
        # R6 置信度分流
        low = [k for k, v in docs.items() if v.get("conf", 1.0) < CONF_HUMAN]
        hard_errors = [r for r in reasons if "不一致" not in r or "金额" in r]
        if low:
            reasons.append("低置信转人工:" + ",".join(low))
        if hard_errors or any("校验位" in r or "过期" in r or "不一致" in r for r in reasons):
            # 硬错误 → reject；仅低置信 → review（人工只看问题材料）
            if any(r for r in reasons if "低置信" not in r):
                return Decision("reject", reasons)
            return Decision("review", reasons)
        return Decision("pass", reasons, auto=True)


def audit(cases: list[dict], engine) -> dict:
    """与 ground truth（defects 非空 = 不应自动通过）对比的混淆矩阵。"""
    tp = fp_auto = false_accept = false_block = review_ok = n = 0
    for c in cases:
        n += 1
        d = engine.review(c)
        bad = bool(c["defects"])
        if d.auto and not bad:
            tp += 1
        elif d.auto and bad:
            false_accept += 1
        elif not bad and d.action == "reject":
            false_block += 1
        elif bad and d.action in ("reject", "review"):
            review_ok += 1
        elif not bad and d.action == "review":
            review_ok += 1  # 低置信复核不算误拦
        else:
            fp_auto += 1
    n_bad = sum(1 for c in cases if c["defects"])
    return {
        "n": n,
        "auto_pass": tp,
        "auto_rate": tp / n,
        "false_accept": false_accept,
        "fa_rate": false_accept / max(1, n_bad),
        "false_block": false_block,
        "fb_rate": false_block / max(1, n - n_bad),
        "accuracy": (tp + review_ok) / n,
    }
