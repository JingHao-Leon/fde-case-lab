"""NO.6 跨境物流装车：生成合成订单数据（固定种子，可复现）。

场景来自《Datawhale FDE 案例 100》NO.6（黑河自贸区中俄跨境贸易）：
货车内净尺寸约 16.4m x 2.47m x 2.67m（约 108 方），货物为 11 种规格的
机电产品（电动车类）包装箱，按"方"计费，98 方为保本线。
"""
from __future__ import annotations

import json
import random
from pathlib import Path

# 车厢内净尺寸（米），对应案例中长 16.4m、宽 2.47m、高 2.67m 的真实车型
TRUCK_L, TRUCK_W, TRUCK_H = 16.4, 2.47, 2.67

# 11 种电动车产品目录（名称，长，宽，高，单订单件数下限/上限）
SPECS = [
    ("滑板车A1", 1.20, 0.40, 0.55, 6, 14),
    ("滑板车A2", 1.35, 0.42, 0.60, 4, 10),
    ("电动自行车B1", 1.75, 0.45, 0.85, 6, 12),
    ("电动自行车B2", 1.80, 0.48, 0.90, 4, 10),
    ("电动摩托C1", 1.90, 0.70, 1.10, 4, 9),
    ("电动摩托C2", 2.05, 0.72, 1.15, 3, 7),
    ("电动三轮D1", 2.80, 1.15, 1.30, 1, 3),
    ("电动三轮D2", 3.00, 1.20, 1.35, 1, 3),
    ("微型电车E1", 2.50, 1.10, 1.55, 1, 4),
    ("配件箱F1", 0.80, 0.60, 0.50, 8, 18),
    ("配件箱F2", 0.60, 0.45, 0.40, 10, 22),
]

BREAK_EVEN_M3 = 98.0   # 保本线（方）
USD_PER_M3 = 100.0     # 超出保本线每方增收（美元）
N_ORDERS = 20


def gen_orders(seed: int = 20260913) -> list[dict]:
    rng = random.Random(seed)
    orders = []
    for i in range(N_ORDERS):
        items = []
        for name, L, W, H, lo, hi in SPECS:
            for _ in range(rng.randint(lo, hi)):
                items.append({"spec": name, "l": L, "w": W, "h": H})
        rng.shuffle(items)
        orders.append({"order_id": f"ORD-{i:03d}", "items": items})
    return orders


def main() -> None:
    out = Path(__file__).parent / "data"
    out.mkdir(exist_ok=True)
    orders = gen_orders()
    (out / "orders.json").write_text(
        json.dumps(orders, ensure_ascii=False, indent=1), encoding="utf-8"
    )
    n_items = sum(len(o["items"]) for o in orders)
    print(f"生成 {len(orders)} 个订单，共 {n_items} 件货 -> {out/'orders.json'}")


if __name__ == "__main__":
    main()
